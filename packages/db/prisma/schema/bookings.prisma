model Booking {
  id             String @id @default(cuid()) @map("_id")
  bookingCode    String // 4 digit code to start service (OTP)
  customerId     String
  professionalId String
  addressId      String

  // Booking Details
  bookingType  BookingType @default(SCHEDULED)
  scheduledFor DateTime
  startTime    DateTime?
  endTime      DateTime?

  // Pricing
  subTotal           Decimal       @db.Decimal(12, 2)
  surgeMultiplier    Decimal       @default(1.0) @db.Decimal(4, 2)
  platformFee        Decimal       @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0.0) @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  // Status
  status             BookingStatus @default(PENDING)
  cancellationReason String?
  cancelledBy        CancelledBy?
  cancelledAt        DateTime?

  // Special Requests
  specialInstructions    String?
  // Rescheduling
  rescheduledFromId      String? // previous booking id if rescheduled
  rescheduledAt          DateTime?
  rescheduledBy          String? // who initiated the reschedule
  // Recurring Booking Reference
  recurringBookingRuleId String?
  autoGenerated          Boolean   @default(false) // created by scheduler
  parentBookingId        String? // for reschedules or rebookings
  recurringIndex         Int? // index of occurrence in recurring series

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  customer            Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  professional        Professional          @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  address             CustomerAddress       @relation(fields: [addressId], references: [id], onDelete: Cascade)
  recurringRule       RecurringBookingRule? @relation(fields: [recurringBookingRuleId], references: [id], onDelete: SetNull)
  items               BookingItem[]
  payment             Payment?
  review              Review?
  BookingNotification BookingNotification[]
  Earning             Earning[]

  @@index([customerId])
  @@index([professionalId])
  @@index([status])
  @@index([scheduledFor])
  @@map("booking")
}

enum BookingType {
  IMMEDIATE // Book now
  SCHEDULED // Book for later (minimum 15 mins advance)
}

enum CancelledBy {
  CUSTOMER
  PROFESSIONAL
  SYSTEM
}

model RecurringBookingRule {
  id              String              @id @default(cuid()) @map("_id")
  customerId      String
  professionalId  String
  serviceId       String
  addressId       String
  startDate       DateTime
  endDate         DateTime?
  frequency       RecurrenceFrequency
  interval        Int                 @default(1) // e.g., every 1 week
  daysOfWeek      DayOfWeek[] // Only for weekly frequency
  status          RecurrenceStatus    @default(ACTIVE)
  startTime       String // e.g., "10:00"
  endTime         String // e.g., "12:00"
  lastGeneratedAt DateTime?
  nextCheckAt     DateTime            @default(now())
  lookAheadCount  Int                 @default(4) // number of occurrences to generate in advance
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Relations
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  professional    Professional    @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service         Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customerAddress CustomerAddress @relation(fields: [addressId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@map("recurring_booking_rule")
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum RecurrenceStatus {
  ACTIVE // keep generating new bookings
  PAUSED // temporarily stop generating new ones
  CANCELLED // stop permanently; can’t resume
  COMPLETED // optional if you add endDate logic
}

enum BookingStatus {
  PENDING // Waiting for professional assignment
  CONFIRMED // Professional assigned
  EN_ROUTE // Professional on the way
  IN_PROGRESS // Service started
  COMPLETED // Service finished
  CANCELLED // Cancelled by customer/professional/admin
  REFUNDED // Payment refunded
}

// Each item/service in a booking
// Example: Cleaning for 2 hours at $15/hour, Cooking for 3 hours at $20/hour
model BookingItem {
  id        String  @id @default(cuid()) @map("_id")
  bookingId String
  serviceId String
  hours     Decimal @db.Decimal(6, 2)
  rate      Decimal @db.Decimal(12, 2) // rate per hour
  amount    Decimal @db.Decimal(12, 2) // total = hours * rate

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([serviceId])
  @@map("booking_item")
}

model BookingNotification {
  id             String                @id @default(cuid()) @map("_id")
  bookingId      String
  professionalId String
  channel        NotificationChannel
  status         NotificationStatus    @default(SENT)
  sentAt         DateTime              @default(now())
  respondedAt    DateTime?
  response       NotificationResponse?
  responseTimeMs Int?
  priority       Int                   @default(1)
  attempt        Int                   @default(1)
  errorMessage   String?

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([professionalId, status])
  @@map("booking_notification")
}

enum NotificationStatus {
  SENT
  READ
  RESPONDED
  EXPIRED
}

enum NotificationResponse {
  ACCEPTED
  REJECTED
  EXPIRED
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  WHATSAPP
}
